{
  "name": "workbase-admin-fornt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging",
    "build:test": "tsc -b && vite build --mode test",
    "check": "pnpm lint && pnpm lint:style && pnpm lint:md && pnpm format:check && pnpm typecheck",
    "commitlint": "commitlint",
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "dev:test": "vite --mode test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:md": "markdownlint-cli2 \"**/*.{md,markdown}\"",
    "lint:md:fix": "markdownlint-cli2 \"**/*.{md,markdown}\" --fix",
    "lint:style": "stylelint \"**/*.{css,less,scss}\" --max-warnings=0",
    "lint:style:fix": "stylelint \"**/*.{css,less,scss}\" --fix --max-warnings=0",
    "lint:unused": "knip",
    "prepare": "husky",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --project unit --coverage",
    "test:lint": "vitest run --project lint",
    "test:ui": "vitest --ui --watch",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -b"
  },
